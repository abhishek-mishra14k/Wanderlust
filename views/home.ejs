<% layout("layouts/boilerplate") %>

<div class="container mt-5">

    <div class="text-center py-5">
        <h1 class="display-3 fw-bold">
            🌍 Wanderlust
        </h1>

        <p class="lead mt-3">
            Discover unique stays, unforgettable experiences,
            and amazing destinations around the world.
        </p>

        <a href="/listings" class="btn btn-dark btn-lg mt-3">
            Explore Listings
        </a>
    </div>

    <hr class="my-5">

    <div class="row text-center">

        <div class="col-md-3 mb-4">
            <i class="fa-solid fa-mountain-city fa-3x mb-3"></i>
            <h4>Mountains</h4>
            <p>Escape into nature with breathtaking mountain stays.</p>
        </div>

        <div class="col-md-3 mb-4">
            <i class="fa-solid fa-umbrella-beach fa-3x mb-3"></i>
            <h4>Beaches</h4>
            <p>Relax beside crystal-clear waters and golden sand.</p>
        </div>

        <div class="col-md-3 mb-4">
            <i class="fa-solid fa-city fa-3x mb-3"></i>
            <h4>Cities</h4>
            <p>Stay in the heart of the world's most iconic cities.</p>
        </div>

        <div class="col-md-3 mb-4">
            <i class="fa-solid fa-tents fa-3x mb-3"></i>
            <h4>Camping</h4>
            <p>Adventure awaits in forests, hills and open skies.</p>
        </div>

    </div>

</div>