<% layout("/layouts/boilerplate") %>

<div class="container">

    <!-- Hero -->

    <section class="text-center mt-5">

        <h1 class="display-2 fw-bold">
            🌍 Wanderlust
        </h1>

        <p class="lead mt-3">
            Discover unique stays, unforgettable experiences, and amazing destinations around the world.
        </p>

        <div class="mt-4">

            <a href="/listings" class="btn btn-danger btn-lg">
                Explore Listings
            </a>

            <a href="https://github.com/abhishek-mishra14k/Wanderlust"
               target="_blank"
               class="btn btn-dark btn-lg ms-3">

                View Source Code

            </a>

        </div>

    </section>


    <!-- Hero Image -->

    <section class="mt-5">

        <img
        src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e"
        class="img-fluid rounded shadow-lg"
        alt="travel">

    </section>


    <!-- Features -->

    <section class="mt-5">

        <h2 class="text-center mb-5">

            Why Wanderlust?

        </h2>

        <div class="row text-center">

            <div class="col-md-3">

                <i class="fa-solid fa-mountain-city fa-3x text-danger"></i>

                <h3 class="mt-3">Mountains</h3>

                <p>Escape into breathtaking mountain destinations.</p>

            </div>

            <div class="col-md-3">

                <i class="fa-solid fa-umbrella-beach fa-3x text-danger"></i>

                <h3 class="mt-3">Beaches</h3>

                <p>Crystal clear water and peaceful beaches.</p>

            </div>

            <div class="col-md-3">

                <i class="fa-solid fa-city fa-3x text-danger"></i>

                <h3 class="mt-3">Cities</h3>

                <p>Luxury stays in iconic cities around the world.</p>

            </div>

            <div class="col-md-3">

                <i class="fa-solid fa-campground fa-3x text-danger"></i>

                <h3 class="mt-3">Camping</h3>

                <p>Adventure in forests and open skies.</p>

            </div>

        </div>

    </section>


    <!-- Statistics -->

    <section class="mt-5">

        <h2 class="text-center mb-5">

            Project Statistics

        </h2>

        <div class="row text-center">

            <div class="col-md-3">

                <h1>100+</h1>

                <p>Listings</p>

            </div>

            <div class="col-md-3">

                <h1>10+</h1>

                <p>Categories</p>

            </div>

            <div class="col-md-3">

                <h1>MongoDB</h1>

                <p>Atlas Database</p>

            </div>

            <div class="col-md-3">

                <h1>Cloudinary</h1>

                <p>Image Storage</p>

            </div>

        </div>

    </section>


    <!-- Features List -->

    <section class="mt-5">

        <h2 class="text-center mb-5">

            Features

        </h2>

        <div class="row">

            <div class="col-md-6">

                <ul class="list-group">

                    <li class="list-group-item">✔ User Authentication</li>

                    <li class="list-group-item">✔ Create Listings</li>

                    <li class="list-group-item">✔ Edit Listings</li>

                    <li class="list-group-item">✔ Delete Listings</li>

                </ul>

            </div>

            <div class="col-md-6">

                <ul class="list-group">

                    <li class="list-group-item">✔ Image Upload</li>

                    <li class="list-group-item">✔ Reviews & Ratings</li>

                    <li class="list-group-item">✔ Search Listings</li>

                    <li class="list-group-item">✔ Categories</li>

                </ul>

            </div>

        </div>

    </section>


    <!-- Tech Stack -->

    <section class="mt-5 mb-5">

        <h2 class="text-center mb-5">

            Tech Stack

        </h2>

        <div class="row text-center">

            <div class="col-md-2">

                <img src="https://skillicons.dev/icons?i=nodejs">

            </div>

            <div class="col-md-2">

                <img src="https://skillicons.dev/icons?i=express">

            </div>

            <div class="col-md-2">

                <img src="https://skillicons.dev/icons?i=mongodb">

            </div>

            <div class="col-md-2">

                <img src="https://skillicons.dev/icons?i=bootstrap">

            </div>

            <div class="col-md-2">

                <img src="https://skillicons.dev/icons?i=git">

            </div>

            <div class="col-md-2">

                <img src="https://skillicons.dev/icons?i=github">

            </div>

        </div>

    </section>

</div>